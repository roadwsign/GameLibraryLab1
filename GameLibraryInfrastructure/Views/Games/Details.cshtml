@model GameLibraryDomain.Model.Game

@{
    ViewData["Title"] = Model.Title;
}

<div class="row mt-4">
    <div class="col-md-4 col-lg-3 mb-4">
        <div class="rounded shadow-lg overflow-hidden" style="border: 1px solid rgba(255,255,255,0.1);">
            @if (!string.IsNullOrWhiteSpace(Model.Posterurl))
            {
                <img src="@Model.Posterurl" alt="Постер @Model.Title" class="img-fluid w-100" style="object-fit: cover;" onerror="this.onerror=null; this.src='https://placehold.co/400x600/1a0933/32fbe2?text=No+Poster';" />
            }
            else
            {
                <div class="ratio ratio-3x4 w-100 d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.05);">
                    <span class="text-white-50">No Poster</span>
                </div>
            }
        </div>
        
        <div class="mt-3 d-flex flex-column gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-light btn-sm">Редагувати гру</a>
            }
            <a asp-action="Index" class="btn btn-link text-white-50 btn-sm text-decoration-none">← Повернутися до каталогу</a>
        </div>
    </div>

    <div class="col-md-8 col-lg-9">
        <div class="mb-4">
            <h1 class="text-white fw-bold mb-1" style="font-size: 2.5rem;">
                @Model.Title <span class="text-white-50 ms-2" style="font-size: 1.5rem; font-weight: normal;">@Model.Releaseyear</span>
            </h1>
            <div class="d-flex gap-2 mt-2 mb-3">
                <span class="badge" style="background-color: #ea39b8; font-size: 0.9rem;">@Model.Genre.Name</span>
                <span class="badge" style="background-color: transparent; border: 1px solid #32fbe2; color: #32fbe2; font-size: 0.9rem;">@Model.Developer.Name</span>
            </div>
            <p class="text-light" style="font-size: 1.1rem; line-height: 1.6;">
                @Model.Description
            </p>
        </div>

        @if (ViewBag.UserLibraryEntry != null)
        {
            var myLib = ViewBag.UserLibraryEntry;
            
            <div class="mb-4 p-4 rounded shadow-sm" style="background: linear-gradient(145deg, rgba(50,251,226,0.1) 0%, rgba(22,12,40,0.5) 100%); border-left: 4px solid #32fbe2;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="text-white m-0 fw-bold">
                        @if (myLib.Isfavorite)
                        {
                            <span class="me-2" style="color: #ea39b8; text-shadow: 0 0 10px #ea39b8;">Улюблена</span>
                        }
                        Мій відгук
                    </h5>
                    <span class="badge px-3 py-2" style="background-color: #6f42c1; font-size: 0.9rem;">@myLib.Status.Statusname</span>
                </div>

                @if (myLib.Rating != null)
                {
                    int fullStars = (int)myLib.Rating;
                    <div class="mb-3 fs-5" style="color: #f1c40f; letter-spacing: 2px;">
                        @for (int i = 0; i < fullStars; i++)
                        {
                            <span>★</span>
                        }
                        @for (int i = fullStars; i < 5; i++)
                        {
                            <span class="text-secondary">★</span>
                        }
                        <span class="text-white-50 fs-6 ms-2 font-monospace">(@myLib.Rating / 5)</span>
                    </div>
                }
                
                @if (!string.IsNullOrWhiteSpace(myLib.Review))
                {
                    <div class="p-3 rounded text-white-50 fst-italic" style="background-color: rgba(255,255,255,0.05); border-left: 2px solid #ea39b8;">
                        "@myLib.Review"
                    </div>
                }
                
                <div class="text-end mt-2 text-white-50" style="font-size: 0.75rem;">
                    Оновлено: @((myLib.Updatedat ?? myLib.Addedat).ToString("dd.MM.yyyy HH:mm"))
                </div>
            </div>
        }

        <div class="p-4 rounded shadow" style="background-color: #160c28; border: 1px solid rgba(111, 66, 193, 0.4);">
            <h5 class="text-white mb-4 fw-bold">Моя бібліотека</h5>
            
            <form asp-action="AddToLibrary" method="post">
                <input type="hidden" name="gameId" value="@Model.Id" />
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-white-50 small mb-1 fw-bold">Статус проходження <span class="text-danger">*</span></label>
                        <select name="statusId" id="statusSelect" class="form-select bg-dark text-white border-secondary" asp-items="ViewBag.Statuses" required>
                            <option value="">Оберіть статус</option>
                        </select>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="text-white-50 small mb-1 fw-bold">Оцінка</label>
                        <input type="number" name="rating" id="ratingInput" value="@(ViewBag.UserLibraryEntry?.Rating)" class="form-control bg-dark text-white border-secondary" min="1" max="5" placeholder="Наприклад: 5" />
                    </div>

                    <div class="col-12">
                        <label class="text-white-50 small mb-1 fw-bold">Відгук</label>
                        <textarea name="review" id="reviewInput" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Напишіть свої враження про гру...">@(ViewBag.UserLibraryEntry?.Review)</textarea>
                    </div>

                    <div class="col-12 d-flex align-items-center justify-content-between mt-4">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" name="isFavorite" id="isFavSwitch" value="true" @(ViewBag.UserLibraryEntry?.Isfavorite == true ? "checked" : "")>
                            <label class="form-check-label text-white ms-2" for="isFavSwitch">Додати в улюблене</label>
                        </div>
    
                        <div class="d-flex gap-2">
                            @if (ViewBag.UserLibraryEntry != null)
                            {
                                <button type="submit" asp-action="RemoveFromLibrary" formnovalidate class="btn btn-outline-danger btn-sm px-3 me-2">Видалити з бібліотеки</button>
                            }

                            <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="clearLibraryForm()">Очистити</button>
                            <button type="submit" class="btn fw-bold px-4" style="background-color: #32fbe2; color: #1a0933;">Зберегти</button>
                        </div>
                    </div>

                </div>
            </form>
        </div>
        
    </div>
</div>
@section Scripts {
    <script>
        function clearLibraryForm() {
            document.getElementById('statusSelect').value = '';
            document.getElementById('ratingInput').value = '';
            document.getElementById('reviewInput').value = '';
            document.getElementById('isFavSwitch').checked = false;
        }
    </script>
}