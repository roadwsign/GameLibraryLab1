<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gaming Lib</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap_vapor.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-dark shadow-sm py-3" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand fw-bold text-uppercase" asp-controller="Home" asp-action="Index">Gaming Lib</a>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Головна</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Games" asp-action="Index">Бібліотека</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Genres" asp-action="Index">Жанри</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Developers" asp-action="Index">Розробники</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Statistics" asp-action="Index">Статистика</a></li>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Users" asp-action="Index">Користувачі</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        <form class="d-flex me-3" asp-controller="Games" asp-action="Index" method="get">
                            <input class="form-control me-2" type="search" name="searchString" placeholder="Пошук гри..." style="width: 160px;">
                            <button class="btn btn-secondary text-white" type="submit">Знайти</button>
                        </form>
                        <div class="d-flex align-items-center">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Account" asp-action="Profile" class="text-info me-3 fw-bold text-decoration-none">Вітаємо, @User.Identity.Name!</a>
                                <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                                    <button type="submit" class="btn btn-outline-danger fw-bold">Вихід</button>
                                </form>
                            }
                            else
                            {
                                <div class="btn-group">
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-info fw-bold">Увійти</a>
                                    <a asp-controller="Account" asp-action="Register" class="btn btn-info fw-bold text-dark">Реєстрація</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container text-center">
            <span class="text-white-50 small">&copy; 2026 - Gaming Lib | </span>
            <a class="text-info text-decoration-none small fw-bold" asp-controller="Home" asp-action="Privacy">Конфіденційність</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>