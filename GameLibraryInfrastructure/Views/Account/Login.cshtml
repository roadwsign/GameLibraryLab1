@model GameLibraryInfrastructure.ViewModels.LoginViewModel

<h2>Вхід в систему</h2>
<form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Email"></label><br />
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <label asp-for="Password"></label><br />
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <label asp-for="RememberMe"></label>
        <input asp-for="RememberMe" />
    </div>
    <div class="mt-3">
        <input type="submit" value="Увійти" class="btn btn-success" />
    </div>
</form>