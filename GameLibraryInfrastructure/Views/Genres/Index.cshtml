@model IEnumerable<GameLibraryDomain.Model.Genre>

@{
    ViewData["Title"] = "Жанри";
}

<h1 class="mb-4 text-white fw-bold">Жанри</h1>

<p class="mb-4">
    <a asp-action="Create" class="btn btn-primary fw-bold" style="background-color: #6f42c1; border: none;">Додати новий жанр</a>
</p>

<div class="mt-4">
    <div class="border-bottom border-secondary border-opacity-50 pb-2 mb-3">
        <span class="text-info fw-bold small text-uppercase">Жанр</span>
    </div>

    @foreach (var item in Model)
    {
        <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 py-3 hover-up">

            <div class="flex-grow-1">
                <h5 class="mb-0 text-white fw-bold">@item.Name</h5>
            </div>

            <div class="flex-shrink-0 ms-3 d-flex flex-column gap-2 text-end align-items-end">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info fw-bold px-4">Ігри цього жанру</a>
                <div class="d-flex justify-content-end gap-2 mt-1">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-white-50 text-decoration-none small hover-text-info">Редагувати</a>
                    <span class="text-white-50 small">|</span>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-white-50 text-decoration-none small hover-text-danger">Видалити</a>
                </div>
            </div>

        </div>
    }
</div>